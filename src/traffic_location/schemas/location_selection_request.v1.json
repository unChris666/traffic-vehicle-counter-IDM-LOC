{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:traffic-location:location_selection_request.v1",
  "type": "object",
  "required": [
    "schema_version",
    "snapshot",
    "manifest_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "location_selection_request_v1"
    },
    "snapshot": {
      "type": "string",
      "minLength": 1
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
