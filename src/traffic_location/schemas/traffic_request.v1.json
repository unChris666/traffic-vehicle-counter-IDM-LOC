{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:traffic-location:traffic-request:v1",
  "type": "object",
  "required": [
    "artifacts",
    "frame_count",
    "profile",
    "schema_version",
    "source_identity",
    "source_manifest_sha256",
    "video_id"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "traffic_request_v1"
    },
    "profile": {
      "enum": [
        "machine",
        "review_assisted",
        "replay"
      ]
    },
    "replay_branch": {
      "enum": [
        "machine",
        "review_assisted"
      ]
    },
    "video_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\]+$"
    },
    "frame_count": {
      "type": "integer",
      "minimum": 1
    },
    "source_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_identity": {
      "type": "object",
      "required": [
        "video_sha256",
        "records_sha256",
        "geometry_sha256",
        "width",
        "height"
      ],
      "properties": {
        "video_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "records_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "geometry_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "artifacts": {
      "type": "object",
      "required": [
        "measurements",
        "geometry",
        "policy"
      ],
      "additionalProperties": false,
      "properties": {
        "adjudications": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "baseline_result": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "baseline_reviews": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "geometry": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "historical_baseline": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "measurements": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "policy": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "relationships": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "review_overlay": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "measurement_format": {
      "enum": [
        "notebook_native",
        "fresh_v1"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "const": "replay"
          }
        }
      },
      "then": {
        "required": [
          "replay_branch"
        ]
      },
      "else": {
        "not": {
          "required": [
            "replay_branch"
          ]
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "profile": {
                "const": "machine"
              }
            }
          },
          {
            "properties": {
              "profile": {
                "const": "replay"
              },
              "replay_branch": {
                "const": "machine"
              }
            },
            "required": [
              "replay_branch"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "artifacts": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "review_overlay"
                  ]
                },
                {
                  "required": [
                    "adjudications"
                  ]
                },
                {
                  "required": [
                    "baseline_result"
                  ]
                }
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "artifacts": {
            "required": [
              "review_overlay",
              "adjudications",
              "baseline_result"
            ]
          }
        }
      }
    }
  ]
}
