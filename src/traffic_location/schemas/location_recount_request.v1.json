{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:traffic-location:location_recount_request.v1",
  "type": "object",
  "required": [
    "schema_version",
    "packet",
    "manifest_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "location_recount_request_v1"
    },
    "packet": {
      "type": "string",
      "minLength": 1
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "previous": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
